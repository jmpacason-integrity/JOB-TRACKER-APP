# Used by docker-compose.yml when running `docker compose up`.
# Copy to .env and fill in real values - never commit the real .env file.

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Any strong random password - generate with: openssl rand -hex 20
POSTGRES_PASSWORD=

# Optional: point a domain's A record at this server's IP to get automatic
# HTTPS via Caddy (e.g. api.yourcompany.com). Leave unset to serve plain
# HTTP on port 80 for initial testing.
DOMAIN=

# Optional: OpenWeatherMap API key for per-job weather forecasts.
OPENWEATHER_API_KEY=
